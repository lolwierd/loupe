{
  "manifest_version": 3,
  "name": "loupe for GitHub",
  "short_name": "loupe",
  "version": "0.1.0",
  "description": "Open GitHub pull requests in loupe, the local review desk: g then l, the toolbar button, or a link's menu.",
  "minimum_chrome_version": "103",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open in loupe",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": { "description": "Open this pull request in loupe" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["link.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": [
    "http://*.local/*",
    "https://*.local/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://[::1]/*"
  ]
}
